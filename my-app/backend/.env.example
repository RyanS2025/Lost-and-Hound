# ── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env — the service role key bypasses all Row-Level Security.

# Supabase — get these from your project's API settings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS — origins allowed to call the API
# Separate multiple origins with commas
CORS_ORIGIN=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com,https://www.yourdomain.com

# Allowed origins for image proxy requests

# Resend — transactional email (resend.com)
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com

# Google Cloud Vision API — image content screening
# Screens every upload for adult content AND for government IDs, payment cards
# and documents carrying personal information, which are deleted rather than
# stored. Costs 2 billable units per image, or 4 when an ambiguous image needs
# a second look, against a 1000/month free tier.
#
# WITHOUT THIS KEY, PRODUCTION REJECTS EVERY IMAGE UPLOAD (fail-closed).
# Locally it accepts them with a loud warning so you can work without a key.
GOOGLE_CLOUD_VISION_API_KEY=

# Railway API — used by the Finances dashboard to pull live billing data
# Generate a token at: railway.app → Account Settings → Tokens
RAILWAY_API_TOKEN=

# WebAuthn Passkeys — relying party configuration
# RP ID is usually the domain (e.g., thelostandhound.com)
# ORIGIN is the full URL(s), comma-separated for www + non-www
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5173

# OneSignal — push notifications for the iOS app
# Get these from your OneSignal dashboard → Settings → Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── Sensitive-image screening ─────────────────────────────────────────────
# Signing key for the verified-upload tokens that tie a screened image to the
# listing it gets attached to. OPTIONAL: falls back to SUPABASE_SERVICE_ROLE_KEY,
# which is already required for the process to boot. Set an explicit value to
# decouple token validity from service-key rotation. Rotating it invalidates at
# most 15 minutes of in-flight uploads.
UPLOAD_TOKEN_SECRET=

# Monthly Google Vision unit ceiling. Past it, production returns the same
# retry-able 503 as any screening outage rather than silently billing you.
# Default 900, against the 1000/month free tier. Set to 0 to disable the cap.
VISION_MONTHLY_UNIT_BUDGET=900

# BREAK GLASS. Set to 1 to accept uploads that could not be screened. While it
# is on, sensitive images are NOT being blocked.
#
# Two legitimate uses:
#   * A Google Vision outage — without this, nobody can post a photo and the
#     only remedy is a redeploy. Turn it back off afterwards.
#   * Local development without a GOOGLE_CLOUD_VISION_API_KEY. Screening fails
#     closed by default in every environment, so without this flag every photo
#     upload on your machine returns 503.
#
# Never set on a deployed environment outside an incident.
IMAGE_SCREENING_FAIL_OPEN=
