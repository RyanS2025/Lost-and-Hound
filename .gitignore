# Root-level ignore rules
node_modules/

# Environment files
.env
.env.*
my-app/.env
my-app/.env.*
my-app/backend/.env
my-app/backend/.env.*

# ...but the templates must stay tracked. The .env.* rules above match
# .env.example too, which is why my-app/backend/.env.example was invisible to
# git: CONTRIBUTING.md tells you to copy it, and a fresh clone had no such file.
!.env.example
!my-app/.env.example
!my-app/backend/.env.example

# Build artifacts
my-app/dist/
my-app/dist-ssr/

# Sensitive credentials — never commit
sensitive-info/
*.p8
*.p12

# Internal docs (shared via Slack, not the repo)
docs/ONBOARDING.md
docs/TASK-SPLIT.md
docs/WIP-SCOPE.md

# OS/editor
.DS_Store
.vscode/
.idea/
.claude/*
!.claude/skills/
.playwright-mcp/
