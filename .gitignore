# Root-level ignore rules
node_modules/

# Environment files
.env
.env.*
my-app/.env
my-app/.env.*
my-app/backend/.env
my-app/backend/.env.*

# Build artifacts
my-app/dist/
my-app/dist-ssr/

# Sensitive credentials — never commit
sensitive-info/
*.p8
*.p12

# Internal docs (shared via Slack, not the repo)
docs/ONBOARDING.md
docs/TASK-SPLIT.md
docs/WIP-SCOPE.md

# OS/editor
.DS_Store
.vscode/
.idea/
.claude/
.playwright-mcp/
